FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/* && python3 -m venv /venv && /venv/bin/pip install --index-url https://pypi.org/simple --no-cache-dir httpx==0.28.1 && npm install -g @openai/codex && mkdir /auth && chown node:node /auth
ENV PATH=/venv/bin:$PATH CODEX_HOME=/auth
WORKDIR /app
COPY codex_worker.py .
USER node
CMD ["python","codex_worker.py"]
